# ---------------------------------------------------------------------------
# Copy to .env and adjust.  .env is git-ignored; never commit real secrets.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# Public base URL of this API. Used to build the embed snippet.
BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
POSTGRES_USER=leadcapture
POSTGRES_PASSWORD=change-me-in-your-own-env
POSTGRES_DB=leadcapture
DATABASE_URL=postgresql+psycopg://leadcapture:change-me-in-your-own-env@db:5432/leadcapture
TEST_DATABASE_URL=postgresql+psycopg://leadcapture:change-me-in-your-own-env@db:5432/leadcapture_test

# --- Auth ------------------------------------------------------------------
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_PER_MINUTE=30
RATE_LIMIT_WIDGET_PER_MINUTE=120

# --- Payload limits --------------------------------------------------------
MAX_BODY_BYTES=8192
MAX_FIELD_LENGTH=2000

# --- Spam ------------------------------------------------------------------
HONEYPOT_FIELD=website_url
MIN_FILL_SECONDS=1.5

# --- Geo enrichment --------------------------------------------------------
# live = call the real free providers (ip-api.com, ipapi.co)
# mock = deterministic mock providers, toggled by the *_UP flags below
GEO_MODE=mock
GEO_TIMEOUT_SECONDS=2.0
GEO_MOCK_A_UP=true
GEO_MOCK_B_UP=true
# Public IP substituted for loopback/private addresses so local demos enrich.
GEO_DEV_FALLBACK_IP=8.8.8.8

# --- Side effects (outbox worker) -----------------------------------------
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_SECONDS=1.0
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_BASE_SECONDS=2
# console | smtp
EMAIL_MODE=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=no-reply@leadcapture.local
# Set true to prove PROBE 5: the side effect always throws, submissions still succeed.
SIDE_EFFECT_FORCE_FAIL=false

# --- Widget asset ----------------------------------------------------------
WIDGET_BUNDLE_VERSION=v1
CONFIG_CACHE_MAX_AGE=60

# --- Host port mappings (change only if a port is already taken locally) ----
API_PORT=8000
TESTSITE_PORT=5500
POSTGRES_PORT=5433
MAILPIT_UI_PORT=8025
